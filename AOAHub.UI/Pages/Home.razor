@page "/"
@using System.Threading
@using AOAHub.UI.Models
@inject HttpClient Http
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>AspectAtlas</PageTitle>

<div class="hero">
    <div class="hero-content">
        <h1>Search for a <span class="accent">card</span></h1>
        <p class="subtitle">Look up any card by name or ability text.</p>

        <div class="search-wrap" @onfocusout="OnFocusOut">
            <label class="search">
                <svg class="search-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
                    <path d="M20 20L16.65 16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
                <input type="search"
                       placeholder="Search cards..."
                       value="@SearchTerm"
                       @oninput="OnSearchInput"
                       @onkeydown="OnKeyDown"
                       @onfocus="OnFocus" />
            </label>

            @if (IsOpen)
            {
                <div class="results">
                    @if (IsLoading)
                    {
                        <div class="result-state">Searching...</div>
                    }
                    else if (HasError)
                    {
                        <div class="result-state">Something went wrong. Try again.</div>
                    }
                    else if (Results is null || Results.Count == 0)
                    {
                        <div class="result-state">No matches for "@SearchTerm".</div>
                    }
                    else
                    {
                        @foreach (var result in Results.Take(8))
                        {
                            <button type="button" class="result" @onclick="() => SelectResult(result)">
                                <span class="result-thumb">
                                    @if (result.Type == "Artist")
                                    {
                                        <ArtistMark Name="@result.Name" Src="@result.ImageUrl" Size="2.75rem" />
                                    }
                                    else if (!string.IsNullOrWhiteSpace(result.ImageUrl))
                                    {
                                        <CardImage Src="@result.ImageUrl" Alt="@result.Name" />
                                    }
                                    else
                                    {
                                        <span class="result-noart">@result.Name[0]</span>
                                    }
                                </span>
                                <span class="result-body">
                                    <span class="result-name">@result.Name</span>
                                    <span class="result-desc">@result.TypeLine</span>
                                </span>
                            </button>
                        }
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string SearchTerm = string.Empty;
    private List<SearchResult>? Results;
    private bool IsOpen;
    private bool IsLoading;
    private bool HasError;
    private CancellationTokenSource? _debounceCts;

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        SearchTerm = e.Value?.ToString() ?? string.Empty;

        // Cancel (but don't dispose) any in-flight search: a still-running
        // continuation below may read cts.Token/IsCancellationRequested after
        // this point, and Dispose() would make that throw.
        _debounceCts?.Cancel();

        if (SearchTerm.Trim().Length < 2)
        {
            Results = null;
            HasError = false;
            IsLoading = false;
            IsOpen = false;
            return;
        }

        var cts = new CancellationTokenSource();
        _debounceCts = cts;

        IsOpen = true;
        IsLoading = true;

        try
        {
            await Task.Delay(250, cts.Token);
            var results = await Http.GetFromJsonAsync<List<SearchResult>>($"search?q={Uri.EscapeDataString(SearchTerm)}", cts.Token);

            if (cts.IsCancellationRequested)
            {
                return;
            }

            Results = results;
            HasError = false;
        }
        catch (OperationCanceledException)
        {
            // superseded by a newer keystroke
        }
        catch (Exception)
        {
            if (!cts.IsCancellationRequested)
            {
                Results = null;
                HasError = true;
            }
        }
        finally
        {
            if (!cts.IsCancellationRequested)
            {
                IsLoading = false;
            }
        }
    }

    private void OnFocus()
    {
        if (SearchTerm.Trim().Length >= 2)
        {
            IsOpen = true;
        }
    }

    private async Task OnFocusOut()
    {
        await Task.Delay(150);
        IsOpen = false;
        StateHasChanged();
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            IsOpen = false;
        }
    }

    private void SelectResult(SearchResult result)
    {
        IsOpen = false;

        Navigation.NavigateTo(result.Type == "Artist" ? $"artists/{result.Id}" : $"cards/{result.Id}");
    }

    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }
}
