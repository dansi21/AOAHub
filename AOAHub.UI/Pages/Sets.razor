@page "/sets"
@using AOAHub.Domain.Entities
@inject HttpClient Http

<PageTitle>Sets - AspectAtlas</PageTitle>

<div class="sets-page">
    <div class="sets-header">
        <h1>Sets</h1>
    </div>

    @if (Error is not null)
    {
        <div class="state">
            <p>@Error</p>
        </div>
    }
    else if (SetList is null)
    {
        <div class="state">
            <p>Loading sets...</p>
        </div>
    }
    else if (SetList.Count == 0)
    {
        <div class="state">
            <p>No sets yet.</p>
        </div>
    }
    else
    {
        <div class="set-grid">
            @foreach (var set in SetList)
            {
                <a class="set-card" href="sets/@set.Id">
                    <SetIcon Src="@set.ImageUrl" Alt="@set.Name" Size="5rem" />
                    <span class="set-code">@set.Code</span>
                    <h2>@set.Name</h2>
                    <span class="set-date">@(set.ReleaseDate?.ToString("MMMM yyyy") ?? "Unreleased")</span>
                </a>
            }
        </div>
    }
</div>

@code {
    private List<Set>? SetList;
    private string? Error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            SetList = await Http.GetFromJsonAsync<List<Set>>("sets");
        }
        catch (Exception)
        {
            Error = "Couldn't load sets right now.";
        }
    }
}
